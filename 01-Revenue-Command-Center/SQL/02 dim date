/* ----------------------------------------------------------
02_dim_date.sql
Purpose : Build a d date dimension covering every year in the source data
Param : @DateOffsetYears adjust all calendar dates forward
		0 = original dates (2011-2014)
		12 = demo mode, data appears to end around 2026
IMPORTANT : use the same offset when loading the FactSales.
This query is safe to re-run
-------------------------------------------------------------- */


USE RevenueDW;
GO

IF OBJECT_ID('dw.DimDate') IS NULL  -- check if the table is not created or available
CREATE TABLE dw.DimDate (
	DateKey				INT				NOT NULL PRIMARY KEY,
	FullDate			DATE			NOT NULL,
	[YEAR]				SMALLINT		NOT NULL,
	[Quarter]			SMALLINT		NOT NULL,
	QuarterName			CHAR(2)			NOT NULL,
	[MonthNumber]		INT				NOT NULL,
	[MonthName]			NVARCHAR(10)	NOT NULL,
	MonthShort			CHAR(3)			NOT NULL,
	YearMonth			CHAR(7)			NOT NULL,
	YearMonthKey		INT				NOT NULL,
	WeekOfYear			INT				NOT NULL,
	[DayOfMonth]		INT				NOT NULL,
	[DayOfWeekNumber]	INT				NOT NULL,
	[DayName]			NVARCHAR(10)	NOT NULL,
	IsWeekend			BIT				NOT NULL
	---IsLatestMonth		BIT				NOT NULL   Depricated
);
GO

DECLARE @DateOffsetYears INT = 12 ---<<< change to 12 for demo mode, this will add 12 years to the OrderDate

DECLARE @StartDate DATE, @EndDate DATE;

-- Get the first and last transaction date from the SalesOrderHeader table in AdventureWorks

SELECT	
	@StartDate = DATEADD( YEAR, @DateOffsetYears, DATEFROMPARTS(YEAR(MIN( sod.OrderDate )), 1, 1)),		--  Starts at 1 Jan of the reporting year
	@EndDate   = DATEADD( YEAR, @DateOffsetYears, DATEFROMPARTS(YEAR(MAX( sod.OrderDate )), 12, 31))		--  Ends at 31 Dec of the reporting year
FROM AdventureWorks2022.Sales.SalesOrderHeader sod;

-- Clean up the dimension table before loading

DELETE FROM dw.DimDate;

;WITH Dates AS (                -- recursive generates the date ffrom 
    SELECT @StartDate AS d
    UNION ALL
    SELECT DATEADD(DAY, 1, d) FROM Dates WHERE d < @EndDate
)
INSERT INTO dw.DimDate (
    DateKey, FullDate, [Year], [Quarter], QuarterName, [MonthNumber], [MonthName],
    MonthShort, YearMonth, YearMonthKey, WeekOfYear, DayOfMonth,
    DayOfWeekNumber, DayName, IsWeekend)
SELECT
    YEAR(d) * 10000 + MONTH(d) * 100 + DAY(d),
    d,
    YEAR(d),
    DATEPART(QUARTER, d),
    'Q' + CAST(DATEPART(QUARTER, d) AS CHAR(1)),
    MONTH(d),
    DATENAME(MONTH, d),
    LEFT(DATENAME(MONTH, d), 3),
    CONVERT(CHAR(7), d, 126),
    YEAR(d) * 100 + MONTH(d),
    DATEPART(ISO_WEEK, d),
    DAY(d),
    (DATEDIFF(DAY, '19000101', d) % 7) + 1,           -- 1900-01-01 was a Monday
    DATENAME(WEEKDAY, d),
    CASE WHEN (DATEDIFF(DAY, '19000101', d) % 7) + 1 IN (6, 7) THEN 1 ELSE 0 END
FROM Dates
OPTION (MAXRECURSION 0);

-- Verify
SELECT MIN(FullDate) AS FirstDate, MAX(FullDate) AS LastDate, COUNT(*) AS DaysLoaded
FROM dw.DimDate;
